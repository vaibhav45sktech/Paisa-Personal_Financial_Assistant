# Copy this file to `.env` and fill in the values.
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-me-to-a-random-64-char-string
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/paisa_db

# --- AI Coach (Gemini) — get a free key at https://aistudio.google.com/ ---
# When set, /coach/ becomes a live multi-turn Gemini chat seeded with your
# financial context. Without it the chat page loads with a friendly warning
# and the app still works normally.
GEMINI_API_KEY=

# --- Optional: PDF statement parsing ---
# Uncomment pdfplumber in requirements.txt, then set this to 1
PDF_PARSING_ENABLED=0
